[Unit]
Description=Overclock GPU (pannello Miner)
After=nvidia-persistenced.service systemd-modules-load.service
ConditionPathExists=/opt/miners/oc.json

[Service]
# senza una scheda NVIDIA il servizio non parte (e non cerca il driver)
ExecCondition=/bin/sh -c 'grep -qs 0x10de /sys/bus/pci/devices/*/vendor'
Type=oneshot
ExecStart=/opt/miners/venv/bin/python3 /opt/miners/oc.py

[Install]
WantedBy=multi-user.target
